<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly scrape on macOS. Replace REPO_PATH, then:
     cp scripts/com.cscomparison.scrape.plist ~/Library/LaunchAgents/
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cscomparison.scrape.plist
     If the Mac is asleep on Monday 10:00, launchd runs the job when it wakes up. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cscomparison.scrape</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPO_PATH/scripts/scrape-and-publish.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/cscomparison-scrape.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cscomparison-scrape.log</string>
</dict>
</plist>
